# Unterpfad hinter dem Reverse-Proxy (muss zum Image-Build passen, Standard /beatblade). Leer = Wurzel.
BASE_PATH=/beatblade
# Zugriffsschutz: open | password | cloudflare
AUTH_MODE=cloudflare
# nur bei AUTH_MODE=password
APP_PASSWORD=
SESSION_SECRET=bitte-zufaellig-setzen
# Upload-Grenzen
MAX_UPLOAD_MB=50
UPLOADS_PER_MINUTE=20
# parallele Analysen (Standard: CPU-Kerne - 1)
#CONCURRENCY=3
# oeffentliche Adresse (fuer den QR-Code im Headset)
PUBLIC_URL=https://beat.kulbarts.com/beatblade
# mitgelieferte Songs beim Start importieren
IMPORT_SEEDS=true
# Host-Bindung fuer docker-compose
BIND=127.0.0.1
HOST_PORT=3000
